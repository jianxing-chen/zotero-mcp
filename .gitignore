# content, real credentials, not portable to CI or other contributors).
/private_tests/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# User config / secrets (never commit credentials)
