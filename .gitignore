# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.env
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Private, machine-local tests that exercise a real zotero.sqlite / local
